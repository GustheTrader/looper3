{
  "name": "looper3",
  "version": "0.1.0",
  "private": true,
  "description": "Looper3 loop gate - per-action autonomy gate for the six harness types.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:tiers": "tsx scripts/check-tool-tiers.ts",
    "bench:gate": "tsx scripts/bench-gate.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "verify": "npm run typecheck && npm run check:tiers && npm run check:gating && npm run test",
    "check:gating": "tsx scripts/check-harness-gating.ts",
    "report:weekly": "tsx scripts/weekly-report.ts"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.5.3",
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
